// vla_testbench Deltoris engine on route 1, built by tools/allo-gen.
// Ported from accelerate/Deltoris.../test/src/compact_accelerator.cadl
// (sha256 10d94f47b87d81608413d24fcd190e432e21f24ab6beabacbd1ae10e256b2a06): statics and the write, run, read and reset
// instructions are the original's, verbatim; only the core block of the run
// instruction is replaced by an invoke of deltoris_engine, an Allo rewrite (one activation per cycle, not bit-serial)
// of engine_run in 02_CADL硬件/bitserial_engine.cadl with the same results
// (integer: exact).
static deltoris__core__control: [u32; 2];
static deltoris__core__batch_count: [u32; 1];
static deltoris__core__last_slot: [u32; 1];
static deltoris__core__slot_valid: [u32; 16];
static deltoris__core__accum: [i32; 64];
static deltoris__core__magnitude: [u32; 16];
static deltoris__core__negative: [u32; 16];
static deltoris__core__weights: [i8; 64];
static deltoris__core__previous: [i32; 4];
static deltoris__core__output: [i32; 4];
static deltoris__sys_command: [u32; 1];
static deltoris__sys_status: [u32; 4];

allo deltoris_engine with s """
import allo
from allo.ir.types import int8, int32, uint32


# engine_run of bitserial_engine.cadl written as Allo would: Y[j] += +-|dX[k]| * W[k][j].
# The original adds W << b for every set bit b of the 8-bit magnitude, which is
# exactly the product: write masks magnitudes to 8 bits, and both wrap at 32 bits.
def deltoris_engine(MAG: uint32[16], NEG: uint32[16], W: int8[64], PREV: int32[4],
                    ACC: int32[64], ctx: int32, cont: int32, n: int32):
    acc4: int32[4] = 0
    for j in range(4):
        acc4[j] = PREV[j]
        if cont != 0:
            acc4[j] = ACC[ctx * 4 + j]
    for i in range(16):  # bank i // 4, activation i % 4
        if i < n * 4:
            m: int32 = MAG[i]
            if NEG[i] != 0:
                m = -m
            for j2 in range(4):
                w: int32 = W[i * 4 + j2]
                acc4[j2] = acc4[j2] + m * w
    for j3 in range(4):
        ACC[ctx * 4 + j3] = acc4[j3]


s = allo.customize(deltoris_engine)
s.partition("deltoris_engine:acc4", dim=1)  # the four sums in registers
s.pipeline(s.get_loops("deltoris_engine")["S_i_1"]["i"])  # one activation per cycle
""";

#[opcode(7'b0101011)]
#[funct3(3'b111)]
#[funct7(7'b0000000)]
rtype deltoris_write(rs1: u5, rs2: u5, rd: u5) {
    let address: u32=_irf[rs1];
    let value: u32=_irf[rs2];
    let accepted: u32=0;
    if (address >= 0) && (address < 4) { deltoris__core__magnitude[(address-0)*4+0]=(value >> 0) & 255; accepted=1; }
    if (address >= 0) && (address < 4) { deltoris__core__magnitude[(address-0)*4+1]=(value >> 8) & 255; accepted=1; }
    if (address >= 0) && (address < 4) { deltoris__core__magnitude[(address-0)*4+2]=(value >> 16) & 255; accepted=1; }
    if (address >= 0) && (address < 4) { deltoris__core__magnitude[(address-0)*4+3]=(value >> 24) & 255; accepted=1; }
    if (address >= 4) && (address < 8) { deltoris__core__negative[(address-4)*4+0]=(value >> 0) & 1; accepted=1; }
    if (address >= 4) && (address < 8) { deltoris__core__negative[(address-4)*4+1]=(value >> 1) & 1; accepted=1; }
    if (address >= 4) && (address < 8) { deltoris__core__negative[(address-4)*4+2]=(value >> 2) & 1; accepted=1; }
    if (address >= 4) && (address < 8) { deltoris__core__negative[(address-4)*4+3]=(value >> 3) & 1; accepted=1; }
    if (address >= 8) && (address < 24) { deltoris__core__weights[(address-8)*4+0]=(value >> 0) & 255; accepted=1; }
    if (address >= 8) && (address < 24) { deltoris__core__weights[(address-8)*4+1]=(value >> 8) & 255; accepted=1; }
    if (address >= 8) && (address < 24) { deltoris__core__weights[(address-8)*4+2]=(value >> 16) & 255; accepted=1; }
    if (address >= 8) && (address < 24) { deltoris__core__weights[(address-8)*4+3]=(value >> 24) & 255; accepted=1; }
    if (address >= 24) && (address < 28) {  deltoris__core__previous[address-24]=bitcast<i32>(value); accepted=1; }
    _irf[rd]=if accepted != 0 {0} else {1};
}
#[opcode(7'b0101011)]
#[funct3(3'b111)]
#[funct7(7'b0000001)]
rtype deltoris_run(rs1: u5, rs2: u5, rd: u5) {
    deltoris__sys_command[0]=_irf[rs1];
    deltoris__sys_status[0]=1;
    deltoris__sys_status[1]=0;
    deltoris__core__control[0]=_irf[rs1] & 15;
    deltoris__core__control[1]=(_irf[rs1] >> 4) & 1;
    deltoris__core__batch_count[0]=_irf[rs2];
    let ctx:u32=deltoris__core__control[0];
    if (ctx < 16) && (deltoris__core__control[1] < 2) && (deltoris__core__batch_count[0] > 0) && (deltoris__core__batch_count[0] <= 4) && (deltoris__sys_command[0] < 32) {
     if (deltoris__core__control[1] == 0) || ((deltoris__core__slot_valid[ctx] != 0)) {
    // core: engine_run as the Allo kernel deltoris_engine
    let core_ctx: u32=deltoris__core__control[0];
    let core_cont: u32=deltoris__core__control[1];
    let core_n: u32=deltoris__core__batch_count[0];
    invoke deltoris_engine(MAG = deltoris__core__magnitude[0 +: 16],
                           NEG = deltoris__core__negative[0 +: 16],
                           W = deltoris__core__weights[0 +: 64],
                           PREV = deltoris__core__previous[0 +: 4],
                           ACC = deltoris__core__accum[0 +: 64],
                           ctx = core_ctx, cont = core_cont, n = core_n);
     deltoris__core__slot_valid[ctx]=1;deltoris__core__last_slot[0]=ctx;

     } else {deltoris__sys_status[1]=2;}
    } else {deltoris__sys_status[1]=1;}
    _irf[rd]=deltoris__sys_status[1];
}
#[opcode(7'b0101011)]
#[funct3(3'b111)]
#[funct7(7'b0000010)]
rtype deltoris_read(rs1: u5, rs2: u5, rd: u5) {
    let address: u32=_irf[rs1];
    let bits: u32=0;
    if (address >= 0) && (address < 4) { bits=0; let packed_core__magnitude_0: i32=deltoris__core__magnitude[(address-0)*4+0]; bits=bits | ((bitcast<u32>(packed_core__magnitude_0) & 255) << 0); let packed_core__magnitude_1: i32=deltoris__core__magnitude[(address-0)*4+1]; bits=bits | ((bitcast<u32>(packed_core__magnitude_1) & 255) << 8); let packed_core__magnitude_2: i32=deltoris__core__magnitude[(address-0)*4+2]; bits=bits | ((bitcast<u32>(packed_core__magnitude_2) & 255) << 16); let packed_core__magnitude_3: i32=deltoris__core__magnitude[(address-0)*4+3]; bits=bits | ((bitcast<u32>(packed_core__magnitude_3) & 255) << 24); }
    if (address >= 4) && (address < 8) { bits=0; let packed_core__negative_0: i32=deltoris__core__negative[(address-4)*4+0]; bits=bits | ((bitcast<u32>(packed_core__negative_0) & 1) << 0); let packed_core__negative_1: i32=deltoris__core__negative[(address-4)*4+1]; bits=bits | ((bitcast<u32>(packed_core__negative_1) & 1) << 1); let packed_core__negative_2: i32=deltoris__core__negative[(address-4)*4+2]; bits=bits | ((bitcast<u32>(packed_core__negative_2) & 1) << 2); let packed_core__negative_3: i32=deltoris__core__negative[(address-4)*4+3]; bits=bits | ((bitcast<u32>(packed_core__negative_3) & 1) << 3); }
    if (address >= 8) && (address < 24) { bits=0; let packed_core__weights_0: i32=deltoris__core__weights[(address-8)*4+0]; bits=bits | ((bitcast<u32>(packed_core__weights_0) & 255) << 0); let packed_core__weights_1: i32=deltoris__core__weights[(address-8)*4+1]; bits=bits | ((bitcast<u32>(packed_core__weights_1) & 255) << 8); let packed_core__weights_2: i32=deltoris__core__weights[(address-8)*4+2]; bits=bits | ((bitcast<u32>(packed_core__weights_2) & 255) << 16); let packed_core__weights_3: i32=deltoris__core__weights[(address-8)*4+3]; bits=bits | ((bitcast<u32>(packed_core__weights_3) & 255) << 24); }
    if (address >= 24) && (address < 28) { let extended: i32=deltoris__core__previous[address-24]; bits=bitcast<u32>(extended); }
    if (address >= 28) && (address < 32) { let extended: i32=deltoris__core__accum[deltoris__core__last_slot[0]*4+(address-28)]; bits=bitcast<u32>(extended); }
    _irf[rd]=bits;
}
#[opcode(7'b0101011)]
#[funct3(3'b111)]
#[funct7(7'b0000011)]
rtype deltoris_reset(rs1: u5, rs2: u5, rd: u5) {
    with clear0: u32=(0,clear0_) do { deltoris__core__control[clear0]=0; let clear0_: u32=clear0+1; } while (clear0_ < 2);
    with clear1: u32=(0,clear1_) do { deltoris__core__batch_count[clear1]=0; let clear1_: u32=clear1+1; } while (clear1_ < 1);
    with clear2: u32=(0,clear2_) do { deltoris__core__last_slot[clear2]=0; let clear2_: u32=clear2+1; } while (clear2_ < 1);
    with clear3: u32=(0,clear3_) do { deltoris__core__slot_valid[clear3]=0; let clear3_: u32=clear3+1; } while (clear3_ < 16);
    with clear4: u32=(0,clear4_) do { deltoris__core__accum[clear4]=0; let clear4_: u32=clear4+1; } while (clear4_ < 64);
    with clear5: u32=(0,clear5_) do { deltoris__core__magnitude[clear5]=0; let clear5_: u32=clear5+1; } while (clear5_ < 16);
    with clear6: u32=(0,clear6_) do { deltoris__core__negative[clear6]=0; let clear6_: u32=clear6+1; } while (clear6_ < 16);
    with clear7: u32=(0,clear7_) do { deltoris__core__weights[clear7]=0; let clear7_: u32=clear7+1; } while (clear7_ < 64);
    with clear8: u32=(0,clear8_) do { deltoris__core__previous[clear8]=0; let clear8_: u32=clear8+1; } while (clear8_ < 4);
    with clear9: u32=(0,clear9_) do { deltoris__core__output[clear9]=0; let clear9_: u32=clear9+1; } while (clear9_ < 4);
    with clear10: u32=(0,clear10_) do { deltoris__sys_command[clear10]=0; let clear10_: u32=clear10+1; } while (clear10_ < 1);
    with clear11: u32=(0,clear11_) do { deltoris__sys_status[clear11]=0; let clear11_: u32=clear11+1; } while (clear11_ < 4);
    _irf[rd]=0;
}
