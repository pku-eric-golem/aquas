// vla_testbench DiTPA engine on route 1, built by tools/allo-gen.
// Ported from accelerate/DiTPA.../test/src/compact_accelerator.cadl
// (sha256 6600087d93e9bf6fc87a40a2e25a73663e6eb0bd7e1ee3aec579e06d94486221): statics and the write, run, read and reset
// instructions are the original's, verbatim; only the core block of the run
// instruction is replaced by an invoke of ditpa_engine, an Allo rewrite
// of engine_run in 02_CADL硬件/reconfigurable_engine.cadl with the same results
// (same order of float operations, exact integers).
static ditpa__core__control: [u32; 2];
static ditpa__core__batch_count: [u32; 1];
static ditpa__core__last_slot: [u32; 1];
static ditpa__core__slot_valid: [u32; 16];
static ditpa__core__accum: [f32; 256];
static ditpa__core__slot_mode: [u32; 16];
static ditpa__core__x: [f32; 16];
static ditpa__core__weights: [f32; 64];
static ditpa__core__previous: [f32; 16];
static ditpa__core__mode: [u32; 1];
static ditpa__core__output: [f32; 16];
static ditpa__sys_command: [u32; 1];
static ditpa__sys_status: [u32; 4];

allo ditpa_engine with s """
import allo
from allo.ir.types import float32, int32


# engine_run of reconfigurable_engine.cadl written as Allo would. Each output
# keeps the original order (seed, then bank 0, 1, 2, 3; inner products as
# (x0*w0 + x1*w1) + (x2*w2 + x3*w3)), so results are bit for bit the same. The
# bank and output loops are one loop with the output varying fastest: a sum is
# used again only 4 (inner) or 16 (outer) iterations later, past the 3-cycle
# HardFloat adder, so the pipelined loop can issue every cycle.
def inner(X: float32[16], W: float32[64], P: float32[16], ACC: float32[256],
          ctx: int32, cont: int32, n: int32):
    acc: float32[4] = 0.0
    for o in range(4):
        acc[o] = P[o]
        if cont != 0:
            acc[o] = ACC[ctx * 16 + o]
    for t in range(16):
        b: int32 = t // 4
        c: int32 = t % 4
        dot: float32 = (X[b * 4] * W[b * 16 + c] + X[b * 4 + 1] * W[b * 16 + 4 + c]) + (
            X[b * 4 + 2] * W[b * 16 + 8 + c] + X[b * 4 + 3] * W[b * 16 + 12 + c])
        nxt: float32 = acc[c] + dot
        if b < n:
            acc[c] = nxt
    for o2 in range(4):
        ACC[ctx * 16 + o2] = acc[o2]


def outer(X: float32[16], W: float32[64], P: float32[16], ACC: float32[256],
          ctx: int32, cont: int32, n: int32):
    acc: float32[16] = 0.0
    for e in range(16):
        acc[e] = P[e]
        if cont != 0:
            acc[e] = ACC[ctx * 16 + e]
    for t in range(64):
        q: int32 = t // 16
        e2: int32 = t % 16
        nxt: float32 = acc[e2] + X[q * 4 + e2 // 4] * W[q * 16 + e2 % 4]
        if q < n:
            acc[e2] = nxt
    for e3 in range(16):
        ACC[ctx * 16 + e3] = acc[e3]


def ditpa_engine(X: float32[16], W: float32[64], P: float32[16], ACC: float32[256],
                 mode: int32, ctx: int32, cont: int32, n: int32):
    if mode == 0:
        inner(X, W, P, ACC, ctx, cont, n)
    else:
        outer(X, W, P, ACC, ctx, cont, n)


s = allo.customize(ditpa_engine)
s.pipeline(s.get_loops("inner")["S_t_1"]["t"])
s.pipeline(s.get_loops("outer")["S_t_1"]["t"])
""";

#[opcode(7'b1111011)]
#[funct3(3'b111)]
#[funct7(7'b0000000)]
rtype ditpa_write(rs1: u5, rs2: u5, rd: u5) {
    let address: u32=_irf[rs1];
    let value: u32=_irf[rs2];
    let accepted: u32=0;
    if (address >= 0) && (address < 16) {  ditpa__core__x[address-0]=bitcast<f32>(value); accepted=1; }
    if (address >= 16) && (address < 80) {  ditpa__core__weights[address-16]=bitcast<f32>(value); accepted=1; }
    if (address >= 80) && (address < 96) {  ditpa__core__previous[address-80]=bitcast<f32>(value); accepted=1; }
    if (address >= 96) && (address < 97) {  ditpa__core__mode[address-96]=value; accepted=1; }
    _irf[rd]=if accepted != 0 {0} else {1};
}
#[opcode(7'b1111011)]
#[funct3(3'b111)]
#[funct7(7'b0000001)]
rtype ditpa_run(rs1: u5, rs2: u5, rd: u5) {
    ditpa__sys_command[0]=_irf[rs1];
    ditpa__sys_status[0]=1;
    ditpa__sys_status[1]=0;
    ditpa__core__control[0]=_irf[rs1] & 15;
    ditpa__core__control[1]=(_irf[rs1] >> 4) & 1;
    ditpa__core__batch_count[0]=_irf[rs2];
    let ctx:u32=ditpa__core__control[0];
    if (ctx < 16) && (ditpa__core__control[1] < 2) && (ditpa__core__batch_count[0] > 0) && (ditpa__core__batch_count[0] <= 4) && (ditpa__sys_command[0] < 32) {
     if (ditpa__core__control[1] == 0) || ((ditpa__core__slot_valid[ctx] != 0) && (ditpa__core__slot_mode[ctx] == ditpa__core__mode[0])) {
    // core: engine_run as the Allo kernel ditpa_engine
    let core_mode: u32=ditpa__core__mode[0];
    let core_ctx: u32=ditpa__core__control[0];
    let core_cont: u32=ditpa__core__control[1];
    let core_n: u32=ditpa__core__batch_count[0];
    invoke ditpa_engine(X = ditpa__core__x[0 +: 16], W = ditpa__core__weights[0 +: 64],
                        P = ditpa__core__previous[0 +: 16], ACC = ditpa__core__accum[0 +: 256],
                        mode = core_mode, ctx = core_ctx, cont = core_cont, n = core_n);
     ditpa__core__slot_valid[ctx]=1;ditpa__core__last_slot[0]=ctx;
     ditpa__core__slot_mode[ctx]=ditpa__core__mode[0];
     } else {ditpa__sys_status[1]=2;}
    } else {ditpa__sys_status[1]=1;}
    _irf[rd]=ditpa__sys_status[1];
}
#[opcode(7'b1111011)]
#[funct3(3'b111)]
#[funct7(7'b0000010)]
rtype ditpa_read(rs1: u5, rs2: u5, rd: u5) {
    let address: u32=_irf[rs1];
    let bits: u32=0;
    if (address >= 0) && (address < 16) { bits=bitcast<u32>(ditpa__core__x[address-0]); }
    if (address >= 16) && (address < 80) { bits=bitcast<u32>(ditpa__core__weights[address-16]); }
    if (address >= 80) && (address < 96) { bits=bitcast<u32>(ditpa__core__previous[address-80]); }
    if (address >= 96) && (address < 97) { bits=ditpa__core__mode[address-96]; }
    if (address >= 97) && (address < 113) { bits=bitcast<u32>(ditpa__core__accum[ditpa__core__last_slot[0]*16+(address-97)]); }
    _irf[rd]=bits;
}
#[opcode(7'b1111011)]
#[funct3(3'b111)]
#[funct7(7'b0000011)]
rtype ditpa_reset(rs1: u5, rs2: u5, rd: u5) {
    with clear0: u32=(0,clear0_) do { ditpa__core__control[clear0]=0; let clear0_: u32=clear0+1; } while (clear0_ < 2);
    with clear1: u32=(0,clear1_) do { ditpa__core__batch_count[clear1]=0; let clear1_: u32=clear1+1; } while (clear1_ < 1);
    with clear2: u32=(0,clear2_) do { ditpa__core__last_slot[clear2]=0; let clear2_: u32=clear2+1; } while (clear2_ < 1);
    with clear3: u32=(0,clear3_) do { ditpa__core__slot_valid[clear3]=0; let clear3_: u32=clear3+1; } while (clear3_ < 16);
    with clear4: u32=(0,clear4_) do { ditpa__core__accum[clear4]=0.0; let clear4_: u32=clear4+1; } while (clear4_ < 256);
    with clear5: u32=(0,clear5_) do { ditpa__core__slot_mode[clear5]=0; let clear5_: u32=clear5+1; } while (clear5_ < 16);
    with clear6: u32=(0,clear6_) do { ditpa__core__x[clear6]=0.0; let clear6_: u32=clear6+1; } while (clear6_ < 16);
    with clear7: u32=(0,clear7_) do { ditpa__core__weights[clear7]=0.0; let clear7_: u32=clear7+1; } while (clear7_ < 64);
    with clear8: u32=(0,clear8_) do { ditpa__core__previous[clear8]=0.0; let clear8_: u32=clear8+1; } while (clear8_ < 16);
    with clear9: u32=(0,clear9_) do { ditpa__core__mode[clear9]=0; let clear9_: u32=clear9+1; } while (clear9_ < 1);
    with clear10: u32=(0,clear10_) do { ditpa__core__output[clear10]=0.0; let clear10_: u32=clear10+1; } while (clear10_ < 16);
    with clear11: u32=(0,clear11_) do { ditpa__sys_command[clear11]=0; let clear11_: u32=clear11+1; } while (clear11_ < 1);
    with clear12: u32=(0,clear12_) do { ditpa__sys_status[clear12]=0; let clear12_: u32=clear12+1; } while (clear12_ < 4);
    _irf[rd]=0;
}
