// Route 1 example: a 4x4 output-stationary FP32 systolic array from the Allo
// library (allo.library.systolic, as in the Allo PLDI'24 paper), built by
// tools/allo-gen. Tiles are 4x4 row-major in the SPMs (16 elements each).
// Array offsets/counts are elements. _mem addresses and row pitches are bytes.
static matA: [f32; 1024];
static matB: [f32; 1024];
static matC: [f32; 1024];

allo systolic4x4_fp32 with s """
import allo
from allo.ir.types import float32
from allo.library.systolic import schedule_systolic, systolic

M, K, N = 4, 4, 4  # one tile per call
Mt, Nt = 4, 4      # PE grid


def systolic4x4_fp32(A: float32[M, K], B: float32[K, N], C: float32[M, N]):
    systolic[float32, float32, float32, M, K, N, Mt, Nt](A, B, C)


# The library schedule unfolds the PE grid and turns the PE-to-PE arrays into
# FIFOs; only its local tile buffers are partitioned, so A, B and C stay plain
# arrays on the HLS top.
array = allo.customize(systolic, instantiate=[float32, float32, float32, M, K, N, Mt, Nt])
schedule_systolic(array)
s = allo.customize(systolic4x4_fp32)
s.compose(array)
""";

// rs1: (A tile << 16) | B tile. rs2: C tile. C = A * B.
#[opcode(7'b0001011)]
#[funct7(7'b0000000)]
rtype systolic4x4(rs1: u5, rs2: u5, rd: u5) {
    let r1: u32 = _irf[rs1];
    let r2: u32 = _irf[rs2];
    let tile_a: u16 = (r1 >> 16) & 32'h3F;
    let tile_b: u16 = r1 & 32'h3F;
    let tile_c: u16 = r2 & 32'h3F;
    invoke systolic4x4_fp32(
        A = matA[tile_a * 16 +: 16],
        B = matB[tile_b * 16 +: 16],
        C = matC[tile_c * 16 +: 16]
    );
    _irf[rd] = 0;
}

// rs1: DRAM byte address of the tile's first row.
// rs2: (SPM element offset << 16) | row pitch bytes.
#[opcode(7'b1111011)]
#[funct7(7'b0000000)]
rtype loadtile_a(rs1: u5, rs2: u5, rd: u5) {
    let dram_base: u32 = _irf[rs1];
    let r2: u32 = _irf[rs2];
    let spm_base: u32 = r2 >> 16;
    let row_pitch: u32 = r2 & 32'hFFFF;
    with
        row: u32 = (0, row_next)
        dram_addr: u32 = (dram_base, dram_next)
        spm_addr: u32 = (spm_base, spm_next)
    do {
        // One 4-element FP32 row = 16 bytes.
        matA[spm_addr +: ] = _mem[dram_addr +: 4];
        let row_next: u32 = row + 1;
        let dram_next: u32 = dram_addr + row_pitch;
        let spm_next: u32 = spm_addr + 4;
    } while (row_next < 4);
    _irf[rd] = 0;
}

// rs1: DRAM byte address of the tile's first row.
// rs2: (SPM element offset << 16) | row pitch bytes.
#[opcode(7'b1111011)]
#[funct7(7'b0000001)]
rtype loadtile_b(rs1: u5, rs2: u5, rd: u5) {
    let dram_base: u32 = _irf[rs1];
    let r2: u32 = _irf[rs2];
    let spm_base: u32 = r2 >> 16;
    let row_pitch: u32 = r2 & 32'hFFFF;
    with
        row: u32 = (0, row_next)
        dram_addr: u32 = (dram_base, dram_next)
        spm_addr: u32 = (spm_base, spm_next)
    do {
        matB[spm_addr +: ] = _mem[dram_addr +: 4];
        let row_next: u32 = row + 1;
        let dram_next: u32 = dram_addr + row_pitch;
        let spm_next: u32 = spm_addr + 4;
    } while (row_next < 4);
    _irf[rd] = 0;
}

// rs1: DRAM byte address of the tile's first row.
// rs2: (SPM element offset << 16) | row pitch bytes.
#[opcode(7'b1111011)]
#[funct7(7'b0000010)]
rtype storetile_c(rs1: u5, rs2: u5, rd: u5) {
    let dram_base: u32 = _irf[rs1];
    let r2: u32 = _irf[rs2];
    let spm_base: u32 = r2 >> 16;
    let row_pitch: u32 = r2 & 32'hFFFF;
    with
        row: u32 = (0, row_next)
        dram_addr: u32 = (dram_base, dram_next)
        spm_addr: u32 = (spm_base, spm_next)
    do {
        _mem[dram_addr +: 4] = matC[spm_addr +: ];
        let row_next: u32 = row + 1;
        let dram_next: u32 = dram_addr + row_pitch;
        let spm_next: u32 = spm_addr + 4;
    } while (row_next < 4);
    _irf[rd] = 0;
}
