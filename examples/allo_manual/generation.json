{
  "allo_source": "thirdparty/allo/allo/__init__.py",
  "target": "vitis_hls",
  "precision": "FP32, separate mul/add",
  "interface": "ap_memory + ap_ctrl_hs; AXI removed before HLS synthesis",
  "schedule": [
    "reorder(\"k\", \"j\")",
    "buffer_at(s.acc, axis=\"i\")",
    "pipeline(\"j\", initiation_interval=1)",
    "pipeline(\"v\", initiation_interval=1)",
    "partition(s.acc, dim=0)"
  ],
  "fp_implementation": "native HardFloat RTL blackboxes, latency=3, II=1",
  "fp_lowering_counts": {
    "hf_add_f32": 2,
    "hf_mul_f32": 1
  }
}
