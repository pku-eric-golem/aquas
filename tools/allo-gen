#!/usr/bin/env python3
"""Build an Aquas ISAX from CADL with an embedded Allo kernel (route 1).

Run with a Python that has Allo installed (on hina:
~/codefield/golem/allo/build/conda-env/bin/python) and, unless --rtl or
--no-csynth is given, with vitis_hls on PATH. The embedded Allo code is
executed as Python.
"""
import argparse
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[1]))

from cadl_frontend.allo_sv_gen.build import build  # noqa: E402
from cadl_frontend.parser import CADLParseError  # noqa: E402


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    parser.add_argument("input", type=Path, help="CADL file with one allo kernel")
    parser.add_argument("-o", "--output", type=Path, required=True)
    group = parser.add_mutually_exclusive_group()
    group.add_argument("--rtl", type=Path,
                       help="use this HLS Verilog directory instead of running Vitis")
    group.add_argument("--no-csynth", dest="csynth", action="store_false",
                       help="stop after writing the HLS project")
    args = parser.parse_args()
    try:
        result = build(args.input, args.output, rtl=args.rtl, csynth=args.csynth)
    except (CADLParseError, ValueError, NotImplementedError, FileNotFoundError) as error:
        print(f"allo-gen: {error}", file=sys.stderr)
        return 1
    if result.main_sv is None:
        print(f"HLS project: {result.hls.directory}")
    else:
        print(f"ISAX wrapper: {result.main_sv}")
        print(f"Chipyard config: {result.output / 'aps_config.yaml'}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
