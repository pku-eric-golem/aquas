#!/usr/bin/env python3
"""Build an Aquas ISAX from CADL with an embedded Allo kernel (route 1).

The embedded Allo code is executed as Python in a separate interpreter that
has Allo installed: --allo-python, else $AQUAS_ALLO_PYTHON, else the one
running this script (on hina: ~/codefield/golem/allo/build/conda-env/bin/python).
Unless --rtl or --no-csynth is given, vitis_hls must be on PATH. The kernel
build is cached in <output>/hls and redone when any of its inputs change.
"""
import argparse
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[1]))

from cadl_frontend.allo_sv_gen.build import build  # noqa: E402
from cadl_frontend.parser import CADLParseError  # noqa: E402


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    parser.add_argument("input", type=Path, help="CADL file with one allo kernel")
    parser.add_argument("-o", "--output", type=Path, required=True)
    group = parser.add_mutually_exclusive_group()
    group.add_argument("--rtl", type=Path,
                       help="use this HLS Verilog directory instead of running Vitis")
    group.add_argument("--no-csynth", dest="csynth", action="store_false",
                       help="stop after writing the HLS project")
    parser.add_argument("--allo-python", help="interpreter with Allo that runs the kernel code")
    parser.add_argument("--rebuild", dest="cache", action="store_false",
                        help="build the kernel again even if the cached build matches")
    args = parser.parse_args()
    try:
        result = build(args.input, args.output, rtl=args.rtl, csynth=args.csynth,
                       allo_python=args.allo_python, cache=args.cache)
    except (CADLParseError, ValueError, NotImplementedError, FileNotFoundError,
            RuntimeError) as error:
        print(f"allo-gen: {error}", file=sys.stderr)
        return 1
    if result.cached:
        print(f"Kernel build reused: {result.hls.directory} (inputs unchanged)")
    if result.main_sv is None:
        print(f"HLS project: {result.hls.directory}")
    else:
        print(f"ISAX wrapper: {result.main_sv}")
        print(f"Chipyard config: {result.output / 'aps_config.yaml'}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
